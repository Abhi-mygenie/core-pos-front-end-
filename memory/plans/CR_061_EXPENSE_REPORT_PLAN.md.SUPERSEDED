  expense-report-kpi-total, expense-report-kpi-avg, expense-report-kpi-count
  expense-report-kpi-days, expense-report-kpi-top-category, expense-report-kpi-highest-day
  expense-report-daily-chart, expense-report-category-chart, expense-report-payment-chart
  expense-report-table, expense-report-table-row-{id}
  expense-report-download-btn, expense-report-download-excel, expense-report-download-pdf
