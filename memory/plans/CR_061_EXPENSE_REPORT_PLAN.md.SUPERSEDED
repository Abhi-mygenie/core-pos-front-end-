## EXECUTION SEQUENCE

### Step 1: `api/services/expenseReportService.js` — NEW (~120 lines)

**File:** `/app/frontend/src/api/services/expenseReportService.js` (NEW)
**Pattern:** Follows `insightsService.js` fetch functions

```javascript
// CR-061: Expense Report Service — client-side aggregation
import api from '../axios';
import { EXPENSE_ENDPOINTS } from '../constants';  // from CR-059 Phase 1

/** Fetch raw expense transactions for date range */
export const fetchExpenseReport = async (fromDate, toDate, paymentMethod = 'All') => {
  // Convert YYYY-MM-DD → DD/MM/YYYY for API
  const from = formatDDMMYYYY(fromDate);
  const to = formatDDMMYYYY(toDate);
  const res = await api.get(
    `${EXPENSE_ENDPOINTS.EXPENSES_REPORT}?from=${from}&to=${to}&payment_method=${paymentMethod}`
  );
  return res.data;
};

/** Client-side aggregation from raw transactions */
export const aggregateExpenses = (rawReport) => {
  const transactions = rawReport.report || [];
  const totalAmount = parseFloat(rawReport.total_amount) || 0;

  // By category
  const byCategory = {};
  // By payment method
  const byPayment = {};
  // By date (daily trend)
  const byDate = {};

  transactions.forEach(t => {
    const amt = parseFloat(t.Amount) || 0;
    const cat = t.Category || 'Unknown';
    const pay = t['Payment Method'] || 'Unknown';
    const date = t['Date & Time'] || '';

    byCategory[cat] = (byCategory[cat] || 0) + amt;
    byPayment[pay] = (byPayment[pay] || 0) + amt;
    byDate[date] = (byDate[date] || { total: 0, count: 0 });
    byDate[date].total += amt;
    byDate[date].count += 1;
  });

  const activeDays = Object.keys(byDate).length;
  const avgDaily = activeDays > 0 ? totalAmount / activeDays : 0;
  const topCategory = Object.entries(byCategory).sort((a, b) => b[1] - a[1])[0];
  const highestDay = Object.entries(byDate).sort((a, b) => b[1].total - a[1].total)[0];

  return {
    totalAmount,
    transactionCount: transactions.length,
    activeDays,
    avgDaily,
    topCategory: topCategory ? { name: topCategory[0], total: topCategory[1] } : null,
    highestDay: highestDay ? { date: highestDay[0], total: highestDay[1].total, count: highestDay[1].count } : null,
    byCategory: Object.entries(byCategory).map(([name, total]) => ({ name, total })).sort((a, b) => b.total - a.total),
    byPayment: Object.entries(byPayment).map(([method, total]) => ({ method, total })).sort((a, b) => b.total - a.total),
    daily: Object.entries(byDate).map(([date, d]) => ({ date, total: d.total, count: d.count })).sort((a, b) => /* date sort */),
    transactions, // raw for table
  };
};

/** Fetch categories for filter dropdown */
export const fetchExpenseCategories = async () => { ... };

/** Fetch payment methods for filter dropdown */
export const fetchPaymentMethods = async () => { ... };

/** Export report as Excel */
export const exportExpenseReport = async (fromDate, toDate) => { ... };

// Date helpers
const formatDDMMYYYY = (isoDate) => { ... };
```

**Verify:** Import + call with sample dates → returns aggregated data.

